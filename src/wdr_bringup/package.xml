  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>wdr_interfaces</exec_depend>
  <exec_depend>wdr_mission</exec_depend>
  <exec_depend>wdr_sim</exec_depend>
  <exec_depend>wdr_tools</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_minimal_tb4_description</exec_depend>
