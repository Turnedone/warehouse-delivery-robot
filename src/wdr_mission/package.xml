<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wdr_mission</name>
  <version>0.1.0</version>
  <description>Mission layer: the task manager (DeliverOrder action server, order queue) and the BehaviorTree.CPP delivery mission with its custom BT nodes.</description>
  <maintainer email="loukas.pavlou11@gmail.com">Loukas Pavlou</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>nav2_behavior_tree</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_srvs</depend>
  <depend>wdr_interfaces</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>opennav_docking_bt</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
